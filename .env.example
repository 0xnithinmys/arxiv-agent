# OpenAI API key (paid) — primary LLM for best quality. https://platform.openai.com/api-keys
# If left blank, the agent skips OpenAI entirely and runs on Groq's free tier below,
# so the assessment's "no paid API key required" constraint still holds out of the box.
OPENAI_API_KEY=

# Groq free-tier API key — used as the free fallback (or as the sole provider
# if OPENAI_API_KEY is blank). https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the default model IDs without touching code.
# OPENAI_MODEL=gpt-5.6-luna
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: override where downloaded PDFs, the Chroma store, and the SQLite
# checkpoint DB are written. Defaults to ./data next to the project root.
# ARXIV_AGENT_DATA_DIR=./data
